 argument  1 = h2o_cl-_r2scan-d4.nw



============================== echo of input deck ==============================
echo
start h2o_cl-_r2scan-d4
memory total 2000 mb noverify

charge -1

geometry units angstrom
 zmatrix
  O
  H 1 R1
  H 1 R2 2 A1
  Cl 1 R3 2 A2 3 D1
 variables
  R1 0.971
  R2 0.962
  R3 2.908
  A1 105.440
  A2 5.835
  D1 180.000
 end
end

basis spherical
 * library def2-tzvpd
end

dft
 xc r2scan
 dftd4 on
 convergence energy 1d-9 density 1d-8 gradient 1d-7
 grid euler lebedev 99 14
end

scf
 thresh 1d-8
 tol2e 1d-14
 maxiter 99
end

driver
 tight
 eprec 1d-8
 maxiter 99
end

task dft optimize
task dft freq

